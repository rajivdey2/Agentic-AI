# Copy to .env and fill in real values. .env is git-ignored.
# LLM narration provider (checked in this order when set):
#   openrouter > gemini > groq > anthropic > openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# SIM_DAY_SECONDS=60
# LLM_TIMEOUT_SECONDS=12
# VERIFY_MAX_ATTEMPTS=2
# CANDIDATE_CAP=15